# woyo configuration — copy to `.env` and fill in what you need.
# Everything here is optional except a model provider key for real runs.

# ===== Model provider (pick ONE) ==========================================
# openai | groq | gemini | openrouter | deepseek | mistral | xai | cohere
# huggingface | ollama | anthropic | g4f | custom | mock
WOYO_PROVIDER=openai
WOYO_MODEL=gpt-4o-mini

# Sensible defaults per provider (verified Sept 2026):
#   groq        -> llama-3.3-70b-versatile        (free tier)
#   gemini      -> gemini-2.5-flash               (free tier, 1M context)
#   openrouter  -> qwen/qwen3.8-27b:free          (17 free models available)
#   mistral     -> mistral-small-latest           (free tier)
#   xai         -> grok-4-fast-non-reasoning      (paid credits)
#   cohere      -> command-a-03-2025              (trial key)
#   huggingface -> openai/gpt-oss-120b            (needs inference credits)
#   ollama      -> qwen3:8b or llama3.1:8b        (local, free, unlimited)
#   g4f         -> see: python -c "import g4f; ..." (experimental, see docs)

# Role overrides (optional). Any OpenAI-compatible "provider:model" ref works,
# e.g. WOYO_PLANNER_MODEL=groq:llama-3.3-70b-versatile
# WOYO_PLANNER_MODEL=
# WOYO_EXECUTOR_MODEL=
# WOYO_SUMMARIZER_MODEL=

# API key. Either set WOYO_API_KEY or the provider-native variable:
#   openai      -> OPENAI_API_KEY
#   groq        -> GROQ_API_KEY
#   gemini      -> GEMINI_API_KEY (or GOOGLE_API_KEY)
#   openrouter  -> OPENROUTER_API_KEY
#   deepseek    -> DEEPSEEK_API_KEY
#   mistral     -> MISTRAL_API_KEY
#   xai         -> XAI_API_KEY
#   cohere      -> COHERE_API_KEY
#   huggingface -> HF_TOKEN (or HUGGINGFACE_API_KEY)
#   anthropic   -> ANTHROPIC_API_KEY
#   custom      -> WOYO_API_KEY + WOYO_BASE_URL (any OpenAI-compatible endpoint)
#   ollama      -> no key needed (http://localhost:11434/v1)
#   g4f         -> no key needed (experimental; pip install "woyo[g4f]")
# WOYO_API_KEY=
# WOYO_BASE_URL=

# ===== Web search (optional; auto-detected: Tavily > Brave > DuckDuckGo) ==
# TAVILY_API_KEY=          # free tier: 1,000 credits/month (tavily.com)
# BRAVE_API_KEY=           # free tier available (brave.com/search/api)
# WOYO_SEARCH_BACKEND=     # tavily | brave | ddg  (ddg needs: pip install woyo[search])
# WOYO_MAX_SEARCH_CALLS=12 # per-task budget: web_search + crawl_site combined

# ===== Research cache (Phase 2) =============================================
# Repeated fetches/searches hit a local SQLite cache instead of the network.
# WOYO_CACHE_ENABLED=true
# WOYO_CACHE_DIR=~/.woyo
# WOYO_CACHE_TTL_S=86400          # fetched pages: 24h
# WOYO_CACHE_SEARCH_TTL_S=3600    # search results: 1h

# ===== Budgets & safety ====================================================
WOYO_MAX_STEPS=15            # max executor LLM calls per task
WOYO_MAX_TOOL_CALLS=30       # max tool executions per task
WOYO_MAX_TIME_S=600          # wall-clock limit per task (seconds)
WOYO_MAX_COST_USD=1.0        # estimated spend limit per task
WOYO_MAX_TOKENS=400000       # total token limit per task
WOYO_REQUIRE_APPROVAL=true   # ask before any tool that writes externally
WOYO_ENABLE_CODE_EXEC=false  # sandboxed python exec (isolated subprocess or docker; see docs/SECURITY.md)
WOYO_ENABLE_SHELL=false      # shell_exec: approval-gated AND off by default (double deny)
WOYO_SANDBOX=local           # local (rlimits + scrubbed env) | docker (--network none, real boundary)
WOYO_WORKSPACE_DIR=~/.woyo/workspace  # persistent cwd for code/shell + file tools
# sub-agents (spawn_agent) budgets
WOYO_SUBAGENT_MAX_STEPS=6
WOYO_SUBAGENT_MAX_TIME_S=90
WOYO_SUBAGENT_MAX_COST_USD=0.10
WOYO_CHAT_APPROVAL_TIMEOUT_S=120  # telegram inline Approve/Deny buttons: max wait

# ===== Context & misc =======================================================
WOYO_CONTEXT_SOFT_LIMIT_TOKENS=24000
WOYO_TOOL_OUTPUT_CAP_CHARS=12000
WOYO_TIMEZONE=UTC            # your IANA timezone, e.g. Africa/Algiers

# ===== Chat frontends (v0.3) ================================================
# Telegram bot: talk to @BotFather -> /newbot -> paste the token here.
# Access control: TELEGRAM_ALLOWED_CHAT_IDS=123456789 (comma-separated).
# When unset, the FIRST chat to send /start claims the bot.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOWED_CHAT_IDS=

# Web chat passcode: REQUIRED before binding to a non-localhost host.
# Per-chat daily message cap and per-message budgets keep costs bounded.
#WOYO_CHAT_PASSWORD=
#WOYO_CHAT_DAILY_MESSAGES=200
#WOYO_CHAT_HISTORY_TURNS=12

# ===== File channel (v0.6) ==================================================
# Inbound attachments are ingested (text/PDF/zip-listing inlined, images and
# voice handled below); send_file delivers workspace files back to the chat.
#WOYO_FILES_DIR=~/.woyo/files      # durable inbox/outbox (synced on runners)
#WOYO_CHAT_MAX_FILE_MB=15          # inbound cap (Telegram Bot API max: 20)
#WOYO_CHAT_MAX_SEND_FILE_MB=45     # outbound cap (Telegram Bot API max: 50)
#WOYO_CHAT_EXTRACT_CHARS=8000      # extracted text inlined per file
# Photos: vision-capable model(s) for image-bearing calls, tried in order.
# Free-tier options verified Sept 2026 (needs OPENROUTER_API_KEY); free
# vision availability fluctuates — the honest text fallback covers outages:
#WOYO_VISION_MODEL=openrouter:dots-studio/dots-3-note-preview:free,openrouter:qwen/qwen3.8-27b:free

# Runner rotation (deploy/gha-telegram): self-rotate after N minutes and
# dispatch the successor run; 0 disables (hard 350-min job timeout instead):
#WOYO_ROTATE_AFTER_MIN=290
# Voice notes: any OpenAI-compatible /audio/transcriptions endpoint.
# e.g. WOYO_ASR_PROVIDER=groq + GROQ_API_KEY (model: whisper-large-v3).
#WOYO_ASR_PROVIDER=
#WOYO_ASR_MODEL=whisper-large-v3

# ===== Persistence, tasks & memory (v0.4) ==================================
# One SQLite file (WAL) holds the resumable task queue and long-term memory.
#WOYO_DB_PATH=~/.woyo/woyo.sqlite3
#WOYO_TASK_CHECKPOINT=true    # checkpoint run state each step (enables resume)
#WOYO_TASK_STALE_MINUTES=10   # running rows older than this are recoverable
#WOYO_MEMORY_ENABLED=true     # long-term memory + recall into prompts
#WOYO_MEMORY_EMBEDDER=auto    # auto | hash | openai (auto = API when available)
#WOYO_MEMORY_EMBED_MODEL=     # default depends on provider
#WOYO_MEMORY_RECALL_K=4       # memories injected into each run's prompt
#WOYO_MEMORY_MIN_SIMILARITY=0.04
#WOYO_MEMORY_MAX_ITEMS=5000   # LRU-ish cap (data minimization)
#WOYO_MEMORY_DEFAULT_TTL_DAYS=180   # 0 = keep until cap

# ===== Future phases (reserved, not used by woyo v0.x yet) ==================
# CLOUDFLARE_API_TOKEN=       # Phase 6: web UI hosting / R2 artifact storage
# VERCEL_TOKEN=               # Phase 6: alternative web UI hosting
